{
    "code-runner.runInTerminal": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
    },
    "search.exclude": {
        "**/.git": true,
        "**/.vscode": true,
        "**/__pycache__": true,
        "**/output": true,
        "**/log": true,
        ".datasets": true,
        ".storage": true,
        "**/.venv/**": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        ".datasets/**": true,
        ".storage/**": true,
    },
    // Editor
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "indent",
    "editor.fontFamily": "JetBrains Mono, D2Coding",
    "editor.fontLigatures": true,
    "editor.fontSize": 18,
    "editor.letterSpacing": 0,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "terminal.integrated.fontFamily": "JetBrains Mono, D2Coding",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // Formatter
    "editor.formatOnSave": true,
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": false,
    },
    "cSpell.words": []
}
