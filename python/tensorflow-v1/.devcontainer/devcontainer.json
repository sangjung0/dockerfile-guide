
{
	"name": "python tensorflow",
	"runArgs": [
		"--gpus=all",
		"--memory=100g"
	],
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},

	// git 필요 없으면 지울 것
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.vscode-pylance",
				"ms-python.python", 
				"ms-python.debugpy",
				"rsip-vision.nvidia-smi-plus",
				"ms-vscode.azurecli",
				"ms-vscode.powershell",
				"hashicorp.terraform",
				"tfsec.tfsec",
				"esbenp.prettier-vscode",
				"ms-toolsai.jupyter"
			]
		}
	}

}

